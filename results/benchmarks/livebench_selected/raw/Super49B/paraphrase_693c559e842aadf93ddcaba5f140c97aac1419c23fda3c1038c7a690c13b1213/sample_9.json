 improvement.\n\nP.P.S Please note that the full list of amended articles and contact details for the Readers’ Editor are available in the original notice.", "logprobs": [{"token": "Section", "logprob": -0.3049810826778412}, {"token": " ", "logprob": -8.702239938429557e-06}, {"token": "1", "logprob": -8.821448318485636e-06}, {"token": "\n", "logprob": -0.009044628590345383}, {"token": "The", "logprob": -0.011395839974284172}, {"token": " Guardian", "logprob": -0.013004845008254051}, {"token": " has", "logprob": -0.23157557845115662}, {"token": " issued", "logprob": -0.11207876354455948}, {"token": " a", "logprob": -0.8449032306671143}, {"token": " series", "logprob": -0.07494916766881943}, {"token": " of", "logprob": -2.7418097943154862e-06}, {"token": " corrections", "logprob": -0.020619560033082962}, {"token": " to", "logprob": -0.021350663155317307}, {"token": " its", "logprob": -1.1057031154632568}, {"token": " recent", "logprob": -0.20581410825252533}, {"token": " articles", "logprob": -0.10221195220947266}, {"token": ",", "logprob": -0.21785549819469452}, {"token": " aiming", "logprob": -0.009421765804290771}, {"token": " to", "logprob": -7.510157047363464e-06}, {"token": " provide", "logprob": -1.5683361291885376}, {"token": " accuracy", "logprob": -0.3288702964782715}, {"token": " and", "logprob": -0.029859298840165138}, {"token": " clarity", "logprob": -0.056001532822847366}, {"token": " to", "logprob": -0.00044741155579686165}, {"token": " its", "logprob": -2.1815061700181104e-05}, {"token": " readers", "logprob": -9.536738616588991e-07}, {"token": ".", "logprob": -0.0004954302567057312}, {"token": " These", "logprob": -0.20476296544075012}, {"token": " corrections", "logprob": -3.0397906812140718e-05}, {"token": " span", "logprob": -0.004909721668809652}, {"token": " various", "logprob": -0.16227160394191742}, {"token": " topics", "logprob": -9.298280929215252e-06}, {"token": ",", "logprob": -8.821098163025454e-05}, {"token": " from", "logprob": -0.018166