act the Readers' Editor at the address or phone number provided.", "logprobs": [{"token": "Section", "logprob": -0.0017500099493190646}, {"token": "", "logprob": 0.0}, {"token": "1", "logprob": 0.0}, {"token": "\n", "logprob": -0.00012337400403339416}, {"token": "\n", "logprob": -0.4279516935348511}, {"token": "The", "logprob": -0.3689146935939789}, {"token": "article", "logprob": -1.360539436340332}, {"token": "\"", "logprob": -0.2968473732471466}, {"token": "D", "logprob": -0.03888270631432533}, {"token": "og", "logprob": -0.04354948177933693}, {"token": "ged", "logprob": -1.9073468138230965e-06}, {"token": "campaign", "logprob": -2.0265373677830212e-05}, {"token": "brings", "logprob": -2.1040890216827393}, {"token": "about", "logprob": -0.43821981549263}, {"token": "new", "logprob": -0.0036591021344065666}, {"token": "pet", "logprob": -0.21715450286865234}, {"token": "theft", "logprob": -5.006777428206988e-06}, {"token": "law", "logprob": -0.07039576023817062}, {"token": "to", "logprob": -0.0010239601833745837}, {"token": "h", "logprob": -1.5848939418792725}, {"token": "inder", "logprob": 0.0}, {"token": "'", "logprob": -0.05502842739224434}, {"token": "dev", "logprob": -0.009505843743681908}, {"token": "ast", "logprob": -2.1457441107486375e-05}, {"token": "ating", "logprob": 0.0}, {"token": "'", "logprob": 0.0}, {"token": "crime", "logprob": -0.16677136719226837}, {"token": "\"", "logprob": -0.0004769618099089712}, {"token": "(", "logprob": -0.3428078293800354}, {"token": "2", "logprob": -0.12444078177213669}, {"token": "5", "logprob": 0.0}, {"token": "August", "logprob": -0.00011717586312443018}, {"token": ",", "logprob": -1.4305104514278355e-06}, {"token": "p", "logprob": -1.5020257706055418e-05}, {"token": "1", "logprob": 0.0}, {"token": "6", "logprob": 0.0}, {"token": ")", "logprob": -0.0008068405441008508}, {"token": "reported", "logprob": -1.8245853185653687}, {"token": "that", "logprob": -0.0018830440239980817}, {"token": "a", "logprob": -0.00817784480750