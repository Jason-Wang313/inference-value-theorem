\nPhone 1234567890\nEmail organizer@email.com\n\nP.S. A post-meeting summary will be distributed to all attendees outlining key decisions and action items. If you are experiencing any hearing impairments and require transcription services please notify us in your attendance confirmation.", "logprobs": [{"token": "Subject", "logprob": -0.012322838418185711}, {"token": ":", "logprob": -0.38190019130706787}, {"token": " Invitation", "logprob": -0.13289590179920197}, {"token": " to", "logprob": -0.0025107308756560087}, {"token": " Strategic", "logprob": -0.20039667189121246}, {"token": " Meeting", "logprob": -0.530946671962738}, {"token": " for", "logprob": -0.5290106534957886}, {"token": " Project", "logprob": -1.04673433303833}, {"token": " Synd", "logprob": -5.757885932922363}, {"token": "icate", "logprob": -0.0013412775006145239}, {"token": "\n\n", "logprob": -0.049177076667547226}, {"token": "Dear", "logprob": -7.533743337262422e-05}, {"token": " Val", "logprob": -0.06012881174683571}, {"token": "ued", "logprob": -0.00012790338951162994}, {"token": " Participants", "logprob": -0.00017188502533826977}, {"token": "\n\n", "logprob": -0.0024434253573417664}, {"token": "I", "logprob": -0.00044371772673912346}, {"token": " am", "logprob": -0.002190454164519906}, {"token": " writing", "logprob": -0.002083513652905822}, {"token": " to", "logprob": -4.768370445162873e-07}, {"token": " formally", "logprob": -0.6542245745658875}, {"token": " invite", "logprob": -7.033323527139146e-06}, {"token": " you", "logprob": -0.008675740100443363}, {"token": " to", "logprob": -0.00017963226127903908}, {"token": " a", "logprob": -9.727005090098828e-05}, {"token": " crucial", "logprob": -0.2400914430618286}, {"token": " meeting", "logprob": -0.0008293526479974389}, {"token": " scheduled", "logprob": -0.38118690252304077}, {"token": " for", "logprob": -0.0013602061662822962}, {"token": " our", "logprob": -0.0231848806142807}, {"token": " ongoing", "logprob": -0.011117419227957726}, {"token